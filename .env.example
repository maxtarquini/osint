# Secrets are read from the environment and are never written by the Raven TUI.
# RAVEN_MONGODB_URI=mongodb://username:password@localhost:27017
# RAVEN_QDRANT_API_KEY=
# RAVEN_NEO4J_PASSWORD=
# RAVEN_AI_API_KEY=
# RAVEN_EMBEDDING_API_KEY=

# Optional endpoint overrides.
# RAVEN_EVIDENCE_ROOT=/absolute/path/to/raven-evidence
# RAVEN_DICTIONARY_ROOT=/absolute/path/to/osint-dictionaries
# RAVEN_QDRANT_URL=http://localhost:6333
# RAVEN_NEO4J_URI=neo4j://localhost:7687
# RAVEN_NEO4J_USERNAME=neo4j
# RAVEN_AI_PROVIDER=ollama
# RAVEN_AI_BASE_URL=http://localhost:11434
# RAVEN_AI_MODEL=qwen3
# RAVEN_AI_THINKING=medium
# RAVEN_AI_TOP_K=40
# RAVEN_AI_RANDOM_SEED=
# RAVEN_AI_TIMEOUT_SECONDS=120
# RAVEN_AI_CONTEXT_SIZE=32768
# RAVEN_EMBEDDING_PROVIDER=ollama
# RAVEN_EMBEDDING_BASE_URL=http://localhost:11434
# RAVEN_EMBEDDING_MODEL=nomic-embed-text
# RAVEN_EMBEDDING_TIMEOUT_SECONDS=120
