}

InvestigationWorkspaceScreen.compact-workspace #graph-preparation-hint {
    display: none;
}

#graph-entity-search {
    height: 3;
    margin: 0;
    width: 1fr;
}

#graph-search-bar { height: 3; }
#graph-filters { width: 12; min-width: 12; }
GraphFiltersScreen { align: center middle; background: rgba(0, 0, 0, 0.65); }
#graph-filter-dialog {
    width: 60;
    height: auto;
    max-height: 24;
    background: $surface;
    border: solid $accent;
    padding: 1 2;
}
#graph-filter-dialog Label { height: 1; }
#graph-filter-actions { height: 3; }

GraphInspectorScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.65);
}

#graph-inspector-dialog {
    width: 90%;
    max-width: 110;
    height: 90%;
    background: $surface;
    border: solid $accent;
    padding: 1 2;
}

#graph-inspector-content {
    height: 1fr;
}

#graph-inspector-sources, #graph-inspector-actions {
    height: 3;
}

#graph-source-select {
    width: 1fr;
}

#graph-inspector-actions Button {
    width: 1fr;
    min-width: 10;
}

#chat-toolbar {
    width: 100%;
    height: 6;
    padding: 1 2;
    background: $surface-raised;
    border: solid $accent-dark;
}

#chat-heading {
    width: 1fr;
}

#chat-token-usage {
    width: 50;
    min-width: 38;
    height: 3;
    margin: 1 1 0 0;
    padding: 0 1;
    content-align: center middle;
    background: $background;
    color: $accent;
    border: tall $accent-dark;
    text-align: center;
    text-style: bold;
}

#index-chat-kb,
#clear-chat {
    width: 13;
    margin-top: 1;
}

#chat-operation-status {
    width: 100%;
    height: 2;
    padding-left: 2;
    content-align: left middle;
    color: $muted;
}

#chat-operation-status.running,
#chat-operation-status.warning,
#chat-operation-status.cancelled {
    color: $warning;
}

#chat-operation-status.success,
#chat-operation-status.ready {
    color: $success;
}

#chat-operation-status.error {
    color: $error;
}

#chat-body {
    width: 100%;
    height: 1fr;
    padding: 1;
}

#chat-conversation {
    width: 1fr;
    height: 100%;
    padding: 1 2;
    border: solid $accent-dark;
    background: $background;
}

#chat-empty {
    width: 100%;
    height: auto;
    min-height: 5;
    padding: 2;
    content-align: center middle;
    color: $muted;
    text-align: center;
}

#chat-context-panel {
    width: 29;
    height: 100%;
    margin-left: 1;
    padding: 1 2 2 2;
    border: solid $accent-dark;
    background: $surface-raised;
}

#chat-context-summary,
.chat-context-note {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: $muted;
}

.chat-context-note {
    padding-top: 1;
    border-top: solid $accent-dark;
}

#chat-composer {
    width: 100%;
    height: 8;
    padding: 1 2 0 2;
    background: $surface-raised;
    border-top: solid $accent-dark;
}

#chat-input-row {
    width: 100%;
    height: 4;
    min-height: 4;
    align-vertical: middle;
}

#chat-input {
    width: 1fr;
    height: 4;
    border: solid $accent-dark;
}

#chat-input:focus {
    border: round $accent;
}

#chat-composer-hint {
    width: 100%;
    height: 2;
    content-align: left middle;
    color: $muted;
}

#send-chat,
#cancel-chat {
    width: 14;
    min-width: 14;
    height: 4;
    margin-left: 1;
}

.chat-message {
    width: 100%;
    height: auto;
    margin: 1 0;
    padding: 0 1 1 1;
    border-left: heavy $accent-dark;
    background: $surface;
}

.chat-message.user {
    margin-left: 8;
    width: 1fr;
    border-left: heavy #357ebd;
    background: #0d1b29;
}

.chat-message.assistant {
    margin-right: 4;
}

.chat-message.local-command {
    border-left: heavy $accent;
    background: $surface-raised;
}

.chat-message.streaming {
    border-left: heavy $warning;
}

.chat-message.error {
    border-left: heavy $error;
}

.chat-message-header {
    width: 100%;
    height: 1;
    color: $accent;
    text-style: bold;
}

.chat-message.user .chat-message-header {
    color: $accent;
}

.chat-markdown {
    width: 100%;
    height: auto;
    margin-top: 1;
    background: transparent;
}

.chat-message-sources {
    width: 100%;
    height: auto;
    margin-top: 1;
    padding-top: 1;
    border-top: solid $accent-dark;
    color: $muted;
}

.chat-message-usage {
    width: 100%;
    height: 1;
    margin-top: 1;
    color: $muted;
    text-align: right;
}

.mermaid-rendered MarkdownFence {
    margin: 0;
    padding: 0 1;
    border: solid $accent-dark;
    background: $background;
    color: $accent;
}

InvestigationWorkspaceScreen.narrow-workspace #chat-context-panel {
    display: none;
}

InvestigationWorkspaceScreen.narrow-workspace #chat-heading {
    display: none;
}

InvestigationWorkspaceScreen.narrow-workspace #chat-token-usage {
    width: 1fr;
    min-width: 28;
}

InvestigationWorkspaceScreen.compact-workspace #chat-toolbar {
    height: 4;
    padding: 0 1;
    border: none;
    border-bottom: solid $accent-dark;
}

InvestigationWorkspaceScreen.compact-workspace #chat-token-usage {
    height: 4;
    margin-top: 0;
    border: none;
    border-left: solid $accent-dark;
    border-right: solid $accent-dark;
}

InvestigationWorkspaceScreen.compact-workspace #chat-heading {
    height: 4;
    padding-top: 0;
}

InvestigationWorkspaceScreen.compact-workspace #index-chat-kb,
InvestigationWorkspaceScreen.compact-workspace #clear-chat {
    height: 4;
    margin-top: 0;
}

InvestigationWorkspaceScreen.compact-workspace #chat-heading .section-description {
    display: none;
}

InvestigationWorkspaceScreen.compact-workspace #chat-body {
    padding: 0;
}

InvestigationWorkspaceScreen.compact-workspace #chat-composer {
    height: 4;
    padding: 0 1;
}

InvestigationWorkspaceScreen.compact-workspace #chat-input-row,
InvestigationWorkspaceScreen.compact-workspace #chat-input {
    height: 3;
    min-height: 3;
}

InvestigationWorkspaceScreen.compact-workspace #workspace-tabs {
    margin-top: 0;
}

InvestigationWorkspaceScreen.narrow-workspace #navigation-context {
    display: none;
}

InvestigationWorkspaceScreen.compact-workspace #chat-composer-hint {
    display: none;
}

ConfirmClearChat {
    align: center middle;
    background: rgba(0, 0, 0, 0.72);
}

#clear-chat-dialog {
    width: 62;
    height: 15;
    padding: 1 2;
    border: round $error;
    background: $surface;
}

#clear-chat-title {
    width: 100%;
    height: 1;
    color: $error;
    text-align: center;
    text-style: bold;
}

#clear-chat-investigation {
    width: 100%;
    height: 2;
    color: $ink;
    content-align: center middle;
    text-align: center;
    text-style: bold;
}

#clear-chat-warning {
    width: 100%;
    height: auto;
    margin-top: 1;
    text-align: center;
    color: $muted;
}

#clear-chat-actions {
    width: 100%;
    height: 3;
    margin-top: 1;
}

#confirm-clear-chat,
#cancel-clear-chat {
    width: 17;
}

ConfirmInvestigationDelete {
    align: center middle;
    background: rgba(0, 0, 0, 0.72);
}

#delete-investigation-dialog {
    width: 68;
    max-width: 96%;
    height: 16;
    padding: 1 2;
    background: $surface;
    border: round $error;
}

#delete-investigation-title {
    width: 100%;
    height: 2;
    color: $error;
    text-align: center;
    text-style: bold;
}

#delete-investigation-name {
    width: 100%;
    height: 2;
    color: $ink;
    text-align: center;
    text-style: bold;
}

#delete-investigation-warning {
    width: 100%;
    height: 4;
    color: $muted;
    text-align: center;
}

#delete-investigation-actions {
    width: 100%;
    height: 3;
    margin-top: 1;
}

#delete-investigation-actions Horizontal {
    width: 42;
    height: 3;
}

#confirm-delete-investigation {
    width: 24;
}

#cancel-delete-investigation {
    width: 18;
}

/* Case workspace: a persistent navigation rail and focused working surfaces. */
#workspace-body { height: 1fr; width: 100%; }
#workspace-rail { display: none; }
InvestigationWorkspaceScreen.rail-workspace #workspace-rail {
    display: block;
    width: 27;
    height: 100%;
    padding: 2 1;
    background: $surface;
    border-right: solid $accent-dark;
}
.rail-heading { height: 2; padding-left: 2; color: $muted; text-style: bold; }
.rail-link {
    width: 100%;
    height: 3;
    border: none;
    border-left: thick transparent;
    background: transparent;
    color: $muted;
    content-align: left middle;
    padding: 0 1;
    text-style: none;
}
.rail-link:hover { background: $panel; color: $foreground; }
.rail-link.selected {
    background: $panel;
    border-left: thick $accent;
    color: $accent;
    text-style: bold;
}
#rail-note { height: 1fr; align-vertical: bottom; padding: 1 2; }
.rail-signature { height: 2; color: $accent; text-style: bold; }
.rail-description { height: auto; color: $muted; }
InvestigationWorkspaceScreen.rail-workspace #workspace-tabs {
    width: 1fr;
    margin: 1 3;
}
InvestigationWorkspaceScreen.rail-workspace #workspace-tabs > ContentTabs { display: none; }
InvestigationWorkspaceScreen.rail-workspace #workspace-summary {
    height: 8;
    padding: 1 3;
}
InvestigationWorkspaceScreen.rail-workspace #workspace-heading { height: 6; }
InvestigationWorkspaceScreen.rail-workspace #workspace-title {
    height: 3;
    content-align: left middle;
    color: $foreground;
    text-style: bold;
}
InvestigationWorkspaceScreen.rail-workspace #workspace-metrics { width: 57; height: 5; }
InvestigationWorkspaceScreen.rail-workspace .workspace-metric {
    width: 18;
    height: 5;
    margin-right: 1;
    padding: 0 2;
    border: round $accent-dark;
    background: $panel;
}
.derived-workspace { height: 1fr; }
.derived-heading { height: 7; padding: 1 2; border-bottom: solid $accent-dark; }
.derived-heading-copy { width: 1fr; height: 5; }
.view-title { height: 2; text-style: bold; color: $foreground; }
.view-subtitle { height: 1; color: $muted; }
.derived-count {
    width: 17;
    height: 4;
    border-left: solid $accent;
    padding-left: 2;
    content-align: left middle;
    color: $accent;
    text-style: bold;
}
.derived-footnote { height: 3; border-top: solid $accent-dark; padding: 1 2 0 2; }
.derived-footnote Static { width: 1fr; color: $muted; height: 1; }
.derived-footnote Static:first-child { width: 27; color: $accent; }
.derived-results { height: 1fr; padding: 2 3; background: $surface; margin: 1 0; }
.workspace-empty-state { height: 1fr; min-height: 0; align: center middle; overflow-y: auto; }
.empty-state-card { width: 76; max-width: 95%; height: auto; align-horizontal: center; padding: 1 2; }
.empty-state-art { width: 100%; height: auto; color: $accent; text-align: center; margin-bottom: 2; }
.empty-state-title { height: auto; width: 100%; text-align: center; text-style: bold; color: $foreground; }
.empty-state-description { height: auto; width: 60; max-width: 100%; text-align: center; color: $muted; margin-top: 1; }
.empty-state-steps { height: 3; width: 100%; margin: 2 0 1 0; }
.empty-state-steps Static {
    width: 1fr;
    height: 3;
    content-align: center middle;
    border-bottom: solid $accent-dark;
    color: $muted;
}
.empty-state-action-row { width: 100%; height: auto; }
.empty-state-action { width: auto; min-width: 28; margin-top: 1; }
#graph-empty { display: none; }
InvestigationWorkspaceScreen.without-graph #graph-empty { display: block; }
InvestigationWorkspaceScreen.without-graph #graph-items-table { display: none; }
InvestigationWorkspaceScreen.compact-workspace .empty-state-art,
InvestigationWorkspaceScreen.compact-workspace .empty-state-steps { display: none; }
InvestigationWorkspaceScreen.compact-workspace .empty-state-card { padding: 0 1; }
InvestigationWorkspaceScreen.compact-workspace .empty-state-action { margin-top: 0; }
InvestigationWorkspaceScreen.compact-workspace #graph-empty .empty-state-description { display: none; }
InvestigationWorkspaceScreen.compact-workspace .derived-heading { height: 5; padding: 0 1; }
InvestigationWorkspaceScreen.compact-workspace .derived-footnote { height: 2; padding: 0 1; }
InvestigationWorkspaceScreen.narrow-workspace .derived-footnote Static:first-child { display: none; }

/* Page catalog: a visible document overview and a source-linked page inspector. */
CatalogSummary { height: auto; max-height: 8; padding: 1 2; background: $panel; border-left: thick $accent; }
.catalog-summary-title { height: 1; color: $accent; text-style: bold; }
.catalog-summary-status { height: auto; color: $foreground; text-style: bold; }
.catalog-summary-content { height: auto; color: $muted; }
#evidence-catalog-summary { margin-top: 1; }
InvestigationWorkspaceScreen.compact-workspace #evidence-catalog-summary {
    max-height: 4; padding: 0 1; margin-top: 0;
}
#evidence-inspector-dialog { width: 96%; max-width: 160; height: 96%; padding: 0 1; }
#evidence-inspector-title, #evidence-inspector-name { height: 1; }
#evidence-inspector-tabs { height: 1fr; }
#document-catalog-summary { max-height: 6; padding: 0 1; }
#document-catalog-summary .catalog-summary-title { display: none; }
#catalog-page-search { height: 3; }
#catalog-page-body { height: 1fr; min-height: 3; }
#catalog-pages-table { width: 45%; height: 100%; }
#catalog-page-details-scroll { width: 1fr; height: 100%; padding: 0 2; border-left: solid $accent-dark; }
#catalog-page-details { height: auto; }
#catalog-read-source { height: 3; width: 22; }
#evidence-inspector-hint { height: 1; width: 100%; color: $muted; }
#evidence-inspector-actions { height: 3; }
#evidence-inspector-actions Button { min-width: 10; width: auto; margin-right: 1; }
#evidence-page-toolbar { height: 3; min-height: 3; }
InvestigationWorkspaceScreen.compact-workspace #evidence-section-header { height: 4; }
InvestigationWorkspaceScreen.compact-workspace #evidence-section-header Button { margin: 0; }
InvestigationWorkspaceScreen.compact-workspace #evidence-operation-status { height: 1; }
InvestigationWorkspaceScreen.compact-workspace #evidence-table {
    min-height: 4; border: none; margin: 0 1;
}
InvestigationWorkspaceScreen.compact-workspace #evidence-table-hint { height: 1; }
EvidenceInspectorScreen.compact-catalog #document-catalog-summary { max-height: 2; }
EvidenceInspectorScreen.compact-catalog #document-catalog-summary .catalog-summary-content { display: none; }
