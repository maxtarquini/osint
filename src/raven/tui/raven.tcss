$ink: $foreground;
$muted: $text-muted;
$accent-dark: $primary-muted;
$surface-raised: $panel;

Screen {
    background: $background;
    color: $ink;
}

Input,
TextArea {
    background: $surface-raised;
    color: $ink;
    border: tall $muted;
}

Input:focus,
TextArea:focus {
    border: tall $accent;
}

Select {
    background: $surface-raised;
    color: $ink;
    border: none;
}

Select > SelectCurrent {
    background: $surface-raised;
    color: $ink;
    border: tall $muted;
}

Select:focus > SelectCurrent {
    border: tall $accent;
}

Button {
    text-style: bold;
}

#top-navigation {
    width: 100%;
    height: 3;
    background: $surface;
    border-bottom: solid $accent-dark;
}

#navigation-brand {
    width: 12;
    height: 3;
    content-align: center middle;
    color: $accent;
    text-style: bold;
}

#navigation-context {
    width: 1fr;
    height: 3;
    padding-right: 2;
    content-align: right middle;
    color: $muted;
    text-style: italic;
}

.navigation-item {
    width: auto;
    min-width: 12;
    height: 3;
    border: none;
    background: $surface;
    color: $muted;
    content-align: center top;
    padding-top: 1;
}

.navigation-item.active {
    background: $accent-dark;
    color: $accent;
    border-bottom: heavy $accent;
    text-style: bold;
}

.navigation-item:hover {
    background: $surface-raised;
    color: $ink;
}

.navigation-item.active:hover {
    background: $accent-dark;
    color: $accent;
}

#home-shell {
    width: 100%;
    height: 1fr;
    align: center middle;
    padding: 0 1;
}

#brand-logo {
    width: 100%;
    height: auto;
    color: $accent;
    text-align: center;
    text-style: bold;
}

#tagline {
    width: 100%;
    color: $muted;
    text-align: center;
    text-style: bold;
}

#primary-action-row {
    width: 100%;
    height: auto;
}

#infrastructure-status {
    width: 100%;
    height: 5;
    align: center middle;
}

.service-status {
    width: 1fr;
    max-width: 24;
    height: 5;
    margin: 0 1;
    padding: 0;
    border: solid $accent-dark;
    background: $surface;
    text-align: center;
    content-align: center middle;
    text-style: bold;
}

.service-status.checking {
    color: $warning;
    border: round $warning;
}

.service-status.connected {
    color: $success;
    border: round $success;
}

.service-status.authentication-required {
    color: $warning;
    border: round $warning;
}

.service-status.configuration-required {
    color: $warning;
    border: round $warning;
}

.service-status.unavailable {
    color: $error;
    border: round $error;
}

#new-investigation {
    width: 32;
    min-width: 24;
}

#configuration-title {
    width: 100%;
    height: 4;
    padding: 0 2;
    content-align: left middle;
    background: $surface;
    border-bottom: solid $accent-dark;
    color: $accent;
    text-style: bold;
}

#secret-hint {
    width: 100%;
    height: 2;
    content-align: center middle;
    background: $surface-raised;
    color: $muted;
    text-align: center;
}

#configuration-tabs {
    width: 100%;
    height: 1fr;
    margin: 1 2 0 2;
}

.config-form {
    padding: 1 2 2 2;
    background: $surface;
    border: solid $accent-dark;
}

.config-form Label {
    margin-top: 1;
    color: $muted;
}

.config-form Input {
    width: 100%;
}

.config-form Select {
    width: 100%;
}

.config-section-title {
    width: 100%;
    height: 3;
    margin-top: 1;
    padding: 1 1 0 1;
    background: $surface-raised;
    border-bottom: solid $accent-dark;
    color: $accent;
    text-style: bold;
}

.ai-parameter-row {
    width: 100%;
    height: 5;
}

.ai-parameter-field {
    width: 1fr;
    height: 5;
    margin-right: 1;
}

.ai-parameter-field Label {
    margin-top: 0;
}

.config-field-hint {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: $muted;
}

#storage-root-row,
#dictionary-root-row {
    width: 100%;
    height: 3;
}

#evidence-storage-root,
#dictionary-root {
    width: 1fr;
}

#browse-evidence-storage,
#browse-dictionary-root {
    width: 12;
}

#storage-layout-hint,
#storage-change-warning,
#storage-environment-hint {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: $muted;
}

#dictionary-layout-hint,
#dictionary-environment-hint {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: $muted;
}

#storage-change-warning {
    color: $warning;
}

#neo4j-password-status {
    width: 100%;
    height: 1;
    margin-top: 1;
    color: $muted;
}

#neo4j-password-status.saved {
    color: $accent;
}

#neo4j-password-status.pending {
    color: $warning;
}

#test-ai-node {
    width: 14;
}

#ai-test-result {
    width: 18;
    height: 3;
    padding-left: 2;
    content-align: left middle;
    color: $muted;
}

#ai-test-result.checking,
#ai-test-result.authentication-required,
#ai-test-result.configuration-required {
    color: $warning;
}

#ai-test-result.connected {
    color: $success;
}

#ai-test-result.unavailable {
    color: $error;
}

#configuration-actions {
    width: 100%;
    height: 6;
    padding: 1 0;
    background: $surface;
    border-top: solid $accent-dark;
}

#configuration-actions Horizontal {
    width: 64;
    height: 3;
}

#save-configuration,
#cancel-configuration {
    width: 16;
}

ConfigurationScreen.compact-configuration #configuration-title {
    height: 3;
}

ConfigurationScreen.compact-configuration #secret-hint {
    height: 1;
}

ConfigurationScreen.compact-configuration #configuration-tabs {
    margin: 0 1;
}

ConfigurationScreen.compact-configuration .config-form {
    padding: 0 1;
    border: none;
}

ConfigurationScreen.compact-configuration #configuration-actions {
    height: 4;
    padding: 0;
}

Footer {
    background: $surface;
    color: $ink;
}

HelpScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.72);
}

#help-dialog {
    width: 42;
    height: auto;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#help-title {
    width: 100%;
    margin-bottom: 1;
    color: $accent;
    text-align: center;
    text-style: bold;
}

#close-help {
    width: 100%;
    margin-top: 1;
}

#investigation-title {
    width: 100%;
    height: 4;
    padding: 0 2;
    content-align: left middle;
    background: $surface;
    border-bottom: solid $accent-dark;
    color: $accent;
    text-style: bold;
}

#investigation-hint,
#evidence-formats {
    width: 100%;
    height: 2;
    content-align: center middle;
    background: $surface-raised;
    color: $muted;
    text-align: center;
}

#investigation-form {
    width: 100%;
    height: 1fr;
    margin: 1 2 0 2;
    padding: 1 2 2 2;
    background: $surface;
    border: solid $accent-dark;
}

#investigation-form Label {
    margin-top: 1;
    color: $muted;
}

#investigation-form Input,
#investigation-form Select,
#investigation-form TextArea {
    width: 100%;
}

#investigation-form .short-editor {
    height: 4;
    border: solid $accent-dark;
}

#investigation-form .questions-editor {
    height: 12;
    min-height: 12;
    border: solid $accent-dark;
}

InvestigationCreateScreen.compact-investigation-form #investigation-form .questions-editor {
    height: 7;
    min-height: 7;
}

#investigation-domain-description {
    width: 100%;
    height: auto;
    color: $muted;
    padding: 0 1;
}

#investigation-actions {
    width: 100%;
    height: 5;
    padding: 1 0;
    background: $surface;
    border-top: solid $accent-dark;
}

#investigation-actions Horizontal {
    width: 64;
    height: 3;
}

#investigation-create-status {
    width: 32;
    height: 3;
    content-align: left middle;
    color: $muted;
}

#investigation-create-status.running {
    color: $warning;
}

#investigation-create-status.error {
    color: $error;
}

#investigation-create-status.cancelled {
    color: $warning;
}

#create-investigation,
#cancel-investigation {
    width: 16;
}

.hidden {
    display: none;
}

#workspace-summary {
    width: 100%;
    height: 6;
    padding: 1 2;
    background: $surface;
    border-bottom: solid $accent-dark;
}

#workspace-heading {
    width: 1fr;
    height: 4;
    padding-left: 1;
}

.section-kicker {
    width: 100%;
    height: 1;
    color: $muted;
    text-style: bold;
}

#workspace-title {
    width: 100%;
    height: 1;
    color: $accent;
    text-style: bold;
}

#workspace-identifier {
    width: 100%;
    height: 1;
    color: $muted;
}

#workspace-metrics {
    width: 39;
    height: 4;
}

.workspace-metric {
    width: 13;
    height: 4;
    padding: 0 1;
    border-left: solid $accent-dark;
    content-align: left middle;
    color: $ink;
}

#workspace-tabs {
    width: 100%;
    height: 1fr;
    margin: 1 2 0 2;
}

#workspace-overview {
    padding: 1;
}

#overview-grid {
    width: 100%;
    height: auto;
}

#overview-case-actions {
    width: 100%;
    height: 5;
    margin-top: 1;
    padding: 1 2;
    background: $surface-raised;
    border-top: solid $accent-dark;
}

#overview-case-actions-hint {
    width: 1fr;
    height: 3;
    content-align: left middle;
    color: $muted;
}

#edit-investigation {
    width: 20;
}

#delete-investigation {
    width: 22;
}

.overview-card {
    height: auto;
    min-height: 5;
    padding: 1 2 2 2;
    border: solid $accent-dark;
    background: $surface-raised;
}

#overview-brief-card {
    width: 2fr;
    height: auto;
    margin-right: 1;
}

#overview-profile-card {
    width: 1fr;
    height: auto;
}

InvestigationWorkspaceScreen.narrow-workspace #overview-grid {
    layout: vertical;
}

InvestigationWorkspaceScreen.narrow-workspace #overview-brief-card,
InvestigationWorkspaceScreen.narrow-workspace #overview-profile-card {
    width: 100%;
    margin-right: 0;
}

InvestigationWorkspaceScreen.narrow-workspace #overview-profile-card {
    margin-top: 1;
}

#overview-questions-card {
    width: 100%;
    margin-top: 1;
}

.panel-title {
    width: 100%;
    height: 2;
    padding: 0 1;
    border-left: heavy $accent;
    color: $accent;
    content-align: left middle;
    text-style: bold;
}

#workspace-description,
#workspace-questions,
#workspace-profile {
    width: 100%;
    height: auto;
    margin-top: 1;
}

#workspace-profile {
    color: $muted;
}

#evidence-section-header {
    width: 100%;
    height: 9;
    padding: 1 2;
    background: $surface-raised;
    border: solid $accent-dark;
}

.section-heading {
    width: 1fr;
    height: 5;
    padding: 0;
}

.section-description {
    width: 100%;
    height: 2;
    padding-left: 1;
    content-align: left middle;
    color: $muted;
}

#index-evidence-rag,
#cancel-rag-index,
#add-evidence,
#cancel-evidence-upload {
    width: 12;
    margin: 1 0;
}

#index-evidence-rag,
#cancel-rag-index {
    width: 13;
}

#evidence-operation-status {
    width: 100%;
    height: 2;
    padding-left: 2;
    content-align: left middle;
    color: $muted;
}

#evidence-operation-status.running,
#evidence-operation-status.cancelled {
    color: $warning;
}

#evidence-operation-status.success {
    color: $success;
}

#evidence-operation-status.error {
    color: $error;
}

#rag-index-progress-strip {
    width: 100%;
    height: 3;
    padding: 0 2;
    align-vertical: middle;
    background: $surface-raised;
    border-bottom: solid $accent-dark;
}

#rag-index-spinner {
    width: 5;
    height: 3;
    color: $accent;
}

#rag-index-progress {
    width: 1fr;
    height: 3;
    color: $accent;
}

#rag-index-progress-detail {
    width: 24;
    height: 3;
    padding-left: 1;
    content-align: right middle;
    color: $muted;
}

#rag-index-progress-strip.success #rag-index-progress-detail {
    color: $success;
}

#rag-index-progress-strip.error #rag-index-progress-detail {
    color: $error;
}

#rag-index-progress-strip.cancelled #rag-index-progress-detail {
    color: $warning;
}

#evidence-count {
    width: 12;
    height: 5;
    padding-right: 1;
    content-align: right middle;
    color: $muted;
}

#evidence-table {
    width: 100%;
    height: 1fr;
    margin: 0 1 1 1;
    border: solid $accent-dark;
    background: $background;
}

#evidence-table > .datatable--header {
    background: $surface-raised;
    color: $accent;
    text-style: bold;
}

#evidence-table > .datatable--cursor {
    background: $accent-dark;
    color: $ink;
}

#evidence-table-hint {
    width: 100%;
    height: 2;
    padding-left: 2;
    color: $muted;
}

/* Persistent background-job workspace */
#jobs-workspace {
    height: 1fr;
    padding: 1 2;
    background: $surface;
}

#jobs-heading {
    height: 5;
    min-height: 5;
    padding: 0 1;
    align-vertical: middle;
    background: $surface-raised;
    border-left: thick $accent;
}

#jobs-heading .section-heading {
    width: 1fr;
}

#jobs-heading Button {
    min-width: 18;
    height: 3;
    margin-left: 1;
}

#jobs-status {
    height: 2;
    padding: 0 1;
}

#jobs-table {
    height: 1fr;
    min-height: 12;
    border: solid $accent-dark;
    background: $background;
}

#jobs-table > .datatable--header {
    background: $surface;
    color: $text-muted;
    text-style: bold;
}

#jobs-hint {
    height: 2;
    padding: 0 1;
    color: $text-muted;
}

.evidence-row {
    width: 100%;
    height: 4;
    border-bottom: solid $accent-dark;
}

.evidence-row Static {
    height: 4;
    content-align: left middle;
}

.evidence-name {
    width: 1fr;
    padding-left: 1;
}

.evidence-format {
    width: 8;
    padding-left: 1;
}

.evidence-pages {
    width: 7;
    padding-left: 1;
}

.evidence-state {
    width: 16;
    padding-left: 1;
}

.evidence-state.pending,
.evidence-state.processing {
    color: $warning;
}

.evidence-state.ready {
    color: $success;
}

.evidence-state.failed {
    color: $error;
}

.evidence-action,
.delete-evidence {
    width: 16;
    min-width: 16;
}

.evidence-action {
    content-align: center middle;
}

EvidenceFilePicker,
EvidenceStorageDirectoryPicker,
MarkdownExportPicker,
NewDirectoryDialog,
ConfirmEvidenceDelete,
EvidenceInspectorScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.72);
}

#evidence-inspector-dialog {
    width: 92%;
    max-width: 132;
    height: 90%;
    min-height: 22;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#evidence-inspector-title {
    width: 100%;
    height: 2;
    color: $accent;
    text-style: bold;
}

#evidence-inspector-name {
    width: 100%;
    height: 2;
    color: $ink;
    text-style: bold;
}

#evidence-inspector-metadata {
    width: 100%;
    height: 9;
    margin-bottom: 1;
}

.evidence-inspector-card {
    width: 18;
    height: 9;
    margin-right: 1;
    padding: 1;
    border: solid $accent-dark;
    color: $muted;
}

.evidence-inspector-wide {
    width: 1fr;
}

#evidence-text-preview {
    width: 100%;
    height: 1fr;
}

#evidence-inspector-actions {
    width: 100%;
    height: 4;
}

#evidence-page-toolbar {
    width: 100%;
    height: 4;
    min-height: 4;
    align-vertical: middle;
}

#evidence-page-toolbar .panel-title {
    width: 1fr;
}

#evidence-page-select {
    width: 20;
    min-width: 20;
    height: 3;
}

#evidence-inspector-hint {
    width: 1fr;
    height: 3;
    color: $muted;
    content-align: left middle;
}

#close-evidence-inspector {
    width: 14;
}

.path-picker-dialog {
    width: 96%;
    min-width: 52;
    max-width: 120;
    height: 94%;
    min-height: 22;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

.path-picker-header {
    width: 100%;
    height: 2;
    padding: 0 1;
    background: $surface-raised;
}

.path-picker-title,
#delete-evidence-title {
    width: 1fr;
    height: 2;
    content-align: left middle;
    color: $accent;
    text-style: bold;
}

#delete-evidence-title {
    width: 100%;
    text-align: center;
}

.path-picker-help {
    width: auto;
    height: 2;
    content-align: right middle;
    color: $muted;
    text-align: right;
}

.path-picker-locations {
    width: 100%;
    height: 4;
    padding-top: 1;
}

.path-picker-locations Button {
    width: 9;
    min-width: 8;
}

#storage-picker-add-folder,
#export-picker-add-folder {
    width: 12;
    min-width: 11;
}

.path-picker-root {
    width: 1fr;
    height: 3;
    padding-left: 1;
    content-align: left middle;
    color: $muted;
}

#evidence-directory-tree,
#storage-directory-tree,
#markdown-export-directory-tree {
    width: 100%;
    height: 1fr;
    border: solid $accent-dark;
    background: $background;
}

.path-picker-selection {
    width: 100%;
    height: 2;
    padding: 0 1;
    background: $surface-raised;
}

.path-picker-selection-label {
    width: 10;
    height: 2;
    content-align: left middle;
    color: $accent;
    text-style: bold;
}

.path-picker-selection-value {
    width: 1fr;
    height: 2;
    content-align: left middle;
    color: $ink;
}

#selected-evidence-format {
    width: 10;
    height: 2;
    content-align: right middle;
    color: $muted;
}

.path-picker-actions {
    width: 100%;
    height: 4;
    padding-top: 1;
}

.path-picker-formats {
    width: 1fr;
    height: 3;
    content-align: left middle;
    color: $muted;
}

#confirm-evidence-file,
#confirm-storage-directory {
    width: 13;
    min-width: 12;
}

#confirm-markdown-export {
    width: 18;
    min-width: 18;
}

#cancel-evidence-file,
#cancel-storage-directory,
#cancel-markdown-export {
    width: 10;
    min-width: 9;
}

.markdown-export-name-row {
    width: 100%;
    height: 4;
    padding-top: 1;
}

.markdown-export-name-label {
    width: 12;
    height: 3;
    color: $accent;
    content-align: left middle;
    text-style: bold;
}

#markdown-export-name {
    width: 1fr;
}

#markdown-export-error {
    width: 100%;
    height: 1;
    color: $error;
}

EvidenceFilePicker.compact-path-picker .path-picker-dialog,
EvidenceStorageDirectoryPicker.compact-path-picker .path-picker-dialog,
MarkdownExportPicker.compact-path-picker .path-picker-dialog {
    padding: 0 1;
}

EvidenceFilePicker.compact-path-picker .path-picker-header,
EvidenceStorageDirectoryPicker.compact-path-picker .path-picker-header,
MarkdownExportPicker.compact-path-picker .path-picker-header,
EvidenceFilePicker.compact-path-picker .path-picker-title,
EvidenceStorageDirectoryPicker.compact-path-picker .path-picker-title,
MarkdownExportPicker.compact-path-picker .path-picker-title,
EvidenceFilePicker.compact-path-picker .path-picker-help,
EvidenceStorageDirectoryPicker.compact-path-picker .path-picker-help,
MarkdownExportPicker.compact-path-picker .path-picker-help {
    height: 1;
    padding: 0;
}

EvidenceFilePicker.compact-path-picker .path-picker-locations,
EvidenceStorageDirectoryPicker.compact-path-picker .path-picker-locations,
MarkdownExportPicker.compact-path-picker .path-picker-locations {
    height: 3;
    padding-top: 0;
}

EvidenceFilePicker.compact-path-picker .path-picker-selection,
EvidenceStorageDirectoryPicker.compact-path-picker .path-picker-selection,
MarkdownExportPicker.compact-path-picker .path-picker-selection,
EvidenceFilePicker.compact-path-picker .path-picker-selection-label,
EvidenceStorageDirectoryPicker.compact-path-picker .path-picker-selection-label,
MarkdownExportPicker.compact-path-picker .path-picker-selection-label,
EvidenceFilePicker.compact-path-picker .path-picker-selection-value,
EvidenceStorageDirectoryPicker.compact-path-picker .path-picker-selection-value,
MarkdownExportPicker.compact-path-picker .path-picker-selection-value,
EvidenceFilePicker.compact-path-picker #selected-evidence-format {
    height: 1;
}

EvidenceFilePicker.compact-path-picker .path-picker-actions,
EvidenceStorageDirectoryPicker.compact-path-picker .path-picker-actions,
MarkdownExportPicker.compact-path-picker .path-picker-actions {
    height: 3;
    padding-top: 0;
}

MarkdownExportPicker.compact-path-picker .markdown-export-name-row {
    height: 3;
    padding-top: 0;
}

#new-directory-dialog {
    width: 90%;
    min-width: 42;
    max-width: 52;
    height: 13;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#new-directory-title {
    width: 100%;
    height: 1;
    color: $accent;
    text-style: bold;
}

#new-directory-parent {
    width: 100%;
    height: 1;
    color: $muted;
}

#new-directory-name {
    width: 100%;
    margin-top: 1;
}

#new-directory-error {
    width: 100%;
    height: 1;
    color: $error;
}

#new-directory-actions {
    width: 100%;
    height: 3;
    align-horizontal: right;
}

#confirm-new-directory,
#cancel-new-directory {
    width: 11;
    min-width: 10;
}

#delete-evidence-dialog {
    width: 60;
    height: auto;
    padding: 1 2;
    border: round $error;
    background: $surface;
}

#delete-evidence-name,
