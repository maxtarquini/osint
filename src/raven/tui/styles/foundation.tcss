/* Textual resolves variables per stylesheet, so shared tokens are repeated here. */
$background: #071012;
$surface: #0d1a1d;
$ink: #d8ede7;
$muted: #91aaa4;
$accent: #42e8b4;
$accent-dark: #215246;
$surface-raised: #102326;
$warning: #f4c95d;
$error: #ff6b6b;

Screen {
    background: $background;
    color: $ink;
}

Input,
Select,
TextArea {
    background: $surface-raised;
    color: $ink;
    border: tall $muted;
}

Input:focus,
Select:focus,
TextArea:focus {
    border: tall $accent;
}

Button {
    text-style: bold;
}

#top-navigation {
    width: 100%;
    height: 3;
    background: $surface;
    border-bottom: solid $accent-dark;
}

#navigation-brand {
    width: 12;
    height: 3;
    content-align: center middle;
    color: $accent;
    text-style: bold;
}

#navigation-context {
    width: 1fr;
    height: 3;
    padding-right: 2;
    content-align: right middle;
    color: $muted;
    text-style: italic;
}

.navigation-item {
    width: auto;
    min-width: 12;
    height: 3;
    border: none;
    background: $surface;
    color: $muted;
}

.navigation-item.active {
    background: $accent-dark;
    color: $accent;
    border-bottom: heavy $accent;
    text-style: bold;
}

.navigation-item:hover {
    background: $surface-raised;
    color: $ink;
}

.navigation-item.active:hover {
    background: $accent-dark;
    color: $accent;
}

#home-shell {
    width: 100%;
    height: 1fr;
    align: center middle;
    padding: 0 1;
}

#brand-logo {
    width: 100%;
    height: auto;
    color: $accent;
    text-align: center;
    text-style: bold;
}

#tagline {
    width: 100%;
    color: $muted;
    text-align: center;
    text-style: bold;
}

#primary-action-row {
    width: 100%;
    height: auto;
}

#infrastructure-status {
    width: 100%;
    height: 5;
    align: center middle;
}

.service-status {
    width: 1fr;
    max-width: 24;
    height: 5;
    margin: 0 1;
    padding: 1 0;
    border: round $muted;
    background: $surface;
    text-align: center;
    text-style: bold;
}

.service-status.checking {
    color: $warning;
    border: round $warning;
}

.service-status.connected {
    color: $accent;
    border: round $accent;
}

.service-status.authentication-required {
    color: $warning;
    border: round $warning;
}

.service-status.configuration-required {
    color: $warning;
    border: round $warning;
}

.service-status.unavailable {
    color: $error;
    border: round $error;
}

#new-investigation {
    width: 32;
    min-width: 24;
}

#configuration-title {
    width: 100%;
    height: 4;
    padding: 0 2;
    content-align: left middle;
    background: $surface;
    border-bottom: solid $accent-dark;
    color: $accent;
    text-style: bold;
}

#secret-hint {
    width: 100%;
    height: 2;
    content-align: center middle;
    background: $surface-raised;
    color: $muted;
    text-align: center;
}

#configuration-tabs {
    width: 100%;
    height: 1fr;
    margin: 1 2 0 2;
}

.config-form {
    padding: 1 2 2 2;
    background: $surface;
    border: round $accent-dark;
}

.config-form Label {
    margin-top: 1;
    color: $muted;
}

.config-form Input {
    width: 100%;
}

.config-form Select {
    width: 100%;
}

.config-section-title {
    width: 100%;
    height: 3;
    margin-top: 1;
    padding: 1 1 0 1;
    background: $surface-raised;
    border-bottom: solid $accent-dark;
    color: $accent;
    text-style: bold;
}

.ai-parameter-row {
    width: 100%;
    height: 5;
}

.ai-parameter-field {
    width: 1fr;
    height: 5;
    margin-right: 1;
}

.ai-parameter-field Label {
    margin-top: 0;
}

.config-field-hint {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: $muted;
}

#storage-root-row,
#dictionary-root-row {
    width: 100%;
    height: 3;
}

#evidence-storage-root,
#dictionary-root {
    width: 1fr;
}

#browse-evidence-storage,
#browse-dictionary-root {
    width: 12;
}

#storage-layout-hint,
#storage-change-warning,
#storage-environment-hint {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: $muted;
}

#dictionary-layout-hint,
#dictionary-environment-hint {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: $muted;
}

#storage-change-warning {
    color: $warning;
}

#neo4j-password-status {
    width: 100%;
    height: 1;
    margin-top: 1;
    color: $muted;
}

#neo4j-password-status.saved {
    color: $accent;
}

#neo4j-password-status.pending {
    color: $warning;
}

#test-ai-node {
    width: 14;
}

#ai-test-result {
    width: 18;
    height: 3;
    padding-left: 2;
    content-align: left middle;
    color: $muted;
}

#ai-test-result.checking,
#ai-test-result.authentication-required,
#ai-test-result.configuration-required {
    color: $warning;
}

#ai-test-result.connected {
    color: $accent;
}

#ai-test-result.unavailable {
    color: $error;
}

#configuration-actions {
    width: 100%;
    height: 5;
    padding: 1 0;
    background: $surface;
    border-top: solid $accent-dark;
}

#configuration-actions Horizontal {
    width: 64;
    height: 3;
}

#save-configuration,
#cancel-configuration {
    width: 16;
}

ConfigurationScreen.compact-configuration #configuration-title {
    height: 3;
}

ConfigurationScreen.compact-configuration #secret-hint {
    height: 1;
}

ConfigurationScreen.compact-configuration #configuration-tabs {
    margin: 0 1;
}

ConfigurationScreen.compact-configuration .config-form {
    padding: 0 1;
    border: none;
}

ConfigurationScreen.compact-configuration #configuration-actions {
    height: 3;
    padding: 0;
}

Footer {
    background: $surface;
    color: $ink;
}


